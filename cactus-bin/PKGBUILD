pkgname=cactus-bin
pkgver=4.1.4
pkgrel=1
pkgdesc='Cactus runtime (prebuilt)'
arch=(x86_64)
url='https://github.com/cactus-compute/cactus'
license=(Apache-2.0)
depends=(glibc)
provides=("cactus=$pkgver" libcactus.so)
conflicts=(cactus)
options=(!debug !strip)
_commit=f4ab2741203a282c6e7b89983de2b5e5b2e805a8
_url="https://huggingface.co/Cactus-Compute/cactus/resolve/$_commit/releases/$pkgver"
_wheel="cactus_runtime-$pkgver-py3-none-manylinux2014_x86_64.whl"
source=("cactus-cli-$pkgver::$_url/linux-x86_64/cactus" "libcactus-$pkgver.a::$_url/linux-x86_64/libcactus.a" "cactus-$pkgver.h::$_url/linux-x86_64/cactus.h" "$_wheel::$_url/python/$_wheel")
noextract=("libcactus-$pkgver.a" "$_wheel")
sha256sums=(SKIP SKIP SKIP SKIP)

prepare() {
  bsdtar -xf "$_wheel" cactus/libcactus.so
}

package() {
  install -Dm755 "cactus-cli-$pkgver" "$pkgdir/usr/bin/cactus"
  install -Dm755 cactus/libcactus.so -t "$pkgdir/usr/lib"
  install -Dm644 "libcactus-$pkgver.a" "$pkgdir/usr/lib/libcactus.a"
  install -Dm644 "cactus-$pkgver.h" "$pkgdir/usr/include/cactus.h"
}
