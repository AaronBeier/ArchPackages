pkgname=ffmpeg-custom
pkgver=9.1.r128583.gb058062a45
pkgrel=1
pkgdesc='Headless git master FFmpeg'
arch=(x86_64)
url='https://ffmpeg.org'
license=(GPL-3.0-or-later)
depends=(aom dav1d fontconfig freetype2 fribidi harfbuzz libass libplacebo libvpx openssl opus svt-av1 vulkan-icd-loader x264 x265)
makedepends=(git nasm vulkan-headers)
optdepends=(gnu-free-fonts noto-fonts)
provides=(libavcodec.so libavdevice.so libavfilter.so libavformat.so libavutil.so libswresample.so libswscale.so ffmpeg ffmpeg-full)
conflicts=(ffmpeg)
source=('git+https://github.com/ffmpeg/ffmpeg')
sha256sums=(SKIP)
options=(!debug)

pkgver() {
  printf '%s.r%s.g%s' "$(git -C ffmpeg describe --tags --long | awk -F'-' '{ sub(/^n/, "", $1); print $1 }')" "$(git -C ffmpeg describe --tags --match 'N' | awk -F'-' '{ print $2 }')" "$(git -C ffmpeg rev-parse --short HEAD)"
}

build() {
  cd ffmpeg

  ./configure \
    --prefix='/usr' \
    --enable-lto \
    \
    --disable-rpath \
    --disable-autodetect \
    --enable-gpl \
    --enable-version3 \
    --enable-shared \
    --disable-debug \
    --disable-static \
    --disable-stripping \
    --disable-htmlpages \
    \
    --cpu=x86-64-v3 \
    \
    --enable-openssl \
    --enable-vulkan \
    --enable-iconv \
    \
    --enable-libaom \
    --enable-libopus \
    --enable-libvpx \
    --enable-libx264 \
    --enable-libx265 \
    --enable-libsvtav1 \
    --enable-libdav1d \
    \
    --enable-libass \
    --enable-libfontconfig \
    --enable-libfribidi \
    --enable-libfreetype \
    --enable-libharfbuzz \
    \
    --enable-libplacebo

  make
}

package() {
  make -C ffmpeg DESTDIR="$pkgdir" install
}