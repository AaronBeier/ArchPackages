pkgname=llama.cpp-gfx906
pkgver=r0.g0000000
pkgrel=1
pkgdesc='llama.cpp gfx906-furnace fork (MI50/MI60, Radeon VII), HIP build with Zen 5 (AVX-512) CPU backend'
arch=(x86_64)
url='https://github.com/sixvolts/llamacpp-gfx906-furnace'
license=(MIT)
depends=(gcc-libs glibc hip-runtime-amd hipblas openssl rocblas)
makedepends=(cmake git rocm-cmake)
source=('git+https://github.com/sixvolts/llamacpp-gfx906-furnace')
sha256sums=(SKIP)
options=(!debug !lto)

pkgver() {
  cd llamacpp-gfx906-furnace
  printf 'r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  CFLAGS+=' -march=znver5 -mtune=znver5'
  CXXFLAGS+=' -march=znver5 -mtune=znver5'

  export ROCM_PATH=/opt/rocm
  export HIPCXX="$(/opt/rocm/bin/hipconfig -l)/clang"
  export HIP_PATH="$(/opt/rocm/bin/hipconfig -R)"

  cmake -S llamacpp-gfx906-furnace -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="/opt/$pkgname" \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_RPATH="/opt/$pkgname/lib" \
    -DLLAMA_BUILD_TESTS=OFF \
    -DLLAMA_BUILD_EXAMPLES=OFF \
    -DGGML_NATIVE=OFF \
    -DGGML_AVX512=ON \
    -DGGML_AVX512_VBMI=ON \
    -DGGML_AVX512_VNNI=ON \
    -DGGML_AVX512_BF16=ON \
    -DGGML_AVX_VNNI=ON \
    -DGGML_CCACHE=OFF \
    -DGGML_HIP=ON \
    -DAMDGPU_TARGETS=gfx906 \
    -DGGML_HIP_GRAPHS=ON
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  # /opt so the zen5 and gfx906 builds can both be installed
  local suffix=${pkgname#llama.cpp-} f name
  install -d "$pkgdir/usr/bin"

  for f in "$pkgdir/opt/$pkgname/bin"/*; do
    name=${f##*/}
    
    case $name in
      *.*) ln -s "/opt/$pkgname/bin/$name" "$pkgdir/usr/bin/${name%.*}-$suffix.${name##*.}" ;;
      *)   ln -s "/opt/$pkgname/bin/$name" "$pkgdir/usr/bin/$name-$suffix" ;;
    esac
  done

  install -Dm644 llamacpp-gfx906-furnace/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
