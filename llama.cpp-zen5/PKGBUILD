pkgname=llama.cpp-zen5
pkgver=b0.r0.g0000000
pkgrel=1
pkgdesc='llama.cpp master, CPU build for Zen 5 (AVX-512) with AMD BLIS'
arch=(x86_64)
url='https://github.com/ggml-org/llama.cpp'
license=(MIT)
depends=(aocl-blis-zen5 gcc-libs glibc openssl)
makedepends=(cmake git)
source=('git+https://github.com/ggml-org/llama.cpp')
sha256sums=(SKIP)
options=(!debug !lto)

pkgver() {
  cd llama.cpp
  printf '%s.r%s.g%s' "$(git describe --tags --abbrev=0)" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  CFLAGS+=' -march=znver5 -mtune=znver5'
  CXXFLAGS+=' -march=znver5 -mtune=znver5'

  cmake -S llama.cpp -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="/opt/$pkgname" \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_RPATH="/opt/$pkgname/lib" \
    -DLLAMA_BUILD_TESTS=OFF \
    -DGGML_NATIVE=OFF \
    -DGGML_AVX512=ON \
    -DGGML_AVX512_VBMI=ON \
    -DGGML_AVX512_VNNI=ON \
    -DGGML_AVX512_BF16=ON \
    -DGGML_AVX_VNNI=ON \
    -DGGML_LTO=ON \
    -DGGML_CCACHE=OFF \
    -DGGML_BLAS=ON \
    -DGGML_BLAS_VENDOR=AOCL_mt \
    -DBLAS_LIBRARIES=/usr/lib/libblis-mt.so \
    -DBLAS_INCLUDE_DIRS=/usr/include/blis
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  # /opt so the zen5 and gfx906 builds can both be installed
  local suffix=${pkgname#llama.cpp-} f name
  install -d "$pkgdir/usr/bin"

  for f in "$pkgdir/opt/$pkgname/bin"/*; do
    name=${f##*/}

    case $name in
      *.*) ln -s "/opt/$pkgname/bin/$name" "$pkgdir/usr/bin/${name%.*}-$suffix.${name##*.}" ;;
      *)   ln -s "/opt/$pkgname/bin/$name" "$pkgdir/usr/bin/$name-$suffix" ;;
    esac
  done
  
  install -Dm644 llama.cpp/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
